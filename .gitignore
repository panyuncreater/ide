# ============================================================
# MiniLang IDE .gitignore
# ============================================================

# --- 构建输出目录 ---
build_*/
out/
x64/
.vs/

# --- 编译产物 ---
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.pdb
*.ilk
*.exp

# --- CMake 生成文件 ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
build.ninja
rules.ninja
.ninja_*
_deps/

# --- Qt 自动生成 ---
moc_*.cpp
ui_*.h
qrc_*.cpp

# --- 测试产物 ---
test_vm
test_vm_advanced
/test_harness/x64/
/test_harness/debug
/test_harness/*.exe
/test_harness/*.obj

# --- 用户本地配置 ---
CMakeUserPresets.json

# --- IDE/编辑器 ---
.trae/
*.swp

# --- 日志 ---
*.log

# --- 文档生成 ---
docs/api/

# --- 杂项 ---
nul
