# ============================================================
# MiniLang IDE .gitignore
# ============================================================

# --- 构建输出目录 ---
# 注：统一使用 out/ 目录（CMakePresets 配置）。build/ 为历史残留，可安全删除。
build/
build_*/
out/
x64/
.vs/

# --- 编译产物 ---
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.pdb
*.ilk
*.exp
*.pch
*.err

# --- CMake 生成文件 ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
build.ninja
rules.ninja
.ninja_*
_deps/
compile_commands.json
.ctest
CTestTestfile.cmake
.cmake/api/

# --- Python 缓存 ---
# R116 引入 CI 脚本（perf_baseline.py / coverage_threshold.py 等）后产生
__pycache__/
*.pyc
*.pyo

# --- Qt 自动生成 ---
moc_*.cpp
ui_*.h
qrc_*.cpp
*.qm            # lrelease 生成的翻译二进制（由 .ts 编译，运行时部署到 exe 旁）

# --- 用户本地配置 ---
CMakeUserPresets.json

# --- IDE/编辑器 ---
.trae/
.trae-html-share-packages/
.idea/
.vscode/
.qoder/
*.swp
*.swo
*~

# --- 日志/临时输出 ---
*.log
build_log*.txt
build_output.txt
build_out.txt
build_err.txt
test*_err.txt
test*_out.txt
# 注：无根 Testing/ 目录（CTest 临时目录仅存在于 out/、build_*/ 构建树内，已由上方规则忽略）；
# 裸 Testing/ 在 Windows core.ignorecase=true 下会误伤 testing/（差分流水线），故不写。

# --- 一次性构建/测试脚本（P2/P3 迭代期间产生） ---
_build_*.bat
build_l*.bat
build_l*.ps1
build_p*.bat
build_temp_*.bat
build_test_*.bat
build_tests.bat
run_*_tests.ps1

# --- 临时调试输出（R154-R165 迭代期间产生） ---
_tmp_*
bld_*.txt
cfg_*.txt
rebuild_*.txt
stdout.txt
stderr.txt
tee_out.txt
match_test_output.txt
tests_list*.txt

# --- 一次性构建/测试脚本（临时） ---
temp_build_*
tmp_build_*
tmp_test_*
tmp_*.mlang

# --- 文档生成 ---
docs/api/
minilang_architecture.png

# --- 根目录迭代残留（2026-07 清扫，历史垃圾已归档至 _archive_cleanup/）---
# 约定：正式脚本一律放 scripts/，根目录不应出现 .py/.i/临时 bat
/_archive_cleanup/
/*.py
/*.i
/_*.txt
/_*.bat
/build_*.txt
/test_*.txt
/check_deps*.bat
/rebuild_*.bat
/get_env.bat
/link_stress.bat
/compile_stress_direct.bat
/force_rebuild_stress.bat

# --- 杂项 ---
nul
/MiniLangIDE_交付物.zip
/MiniLangIDE_源代码.zip
/minilang_demo/minilang_demo.mp4
/ppt/MiniLang.pptx
/samples/mini/untitled.mini
