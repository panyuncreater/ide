# ============================================================
# MiniLang IDE .gitignore
# ============================================================

# --- 构建输出目录 ---
build_*/
out/
x64/
.vs/

# --- 编译产物 ---
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.pdb
*.ilk
*.exp
*.pch
*.err

# --- CMake 生成文件 ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
build.ninja
rules.ninja
.ninja_*
_deps/
compile_commands.json
.ctest
CTestTestfile.cmake
.cmake/api/

# --- Qt 自动生成 ---
moc_*.cpp
ui_*.h
qrc_*.cpp

# --- 用户本地配置 ---
CMakeUserPresets.json

# --- IDE/编辑器 ---
.trae/
.idea/
.vscode/
*.swp
*.swo
*~

# --- 日志/临时输出 ---
*.log
*.txt
!CMakeLists.txt
!README.md
!LICENSE
!CODEOWNERS
!CONTRIBUTORS

# --- 文档生成 ---
docs/api/

# --- 杂项 ---
nul
