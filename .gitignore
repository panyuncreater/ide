# ============================================================
# MiniLang IDE .gitignore
# ============================================================

# --- 构建输出目录 ---
# 注：统一使用 out/ 目录（CMakePresets 配置）。build/ 为历史残留，可安全删除。
build/
out/
x64/
.vs/

# --- 编译产物 ---
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.pdb
*.ilk
*.exp
*.pch
*.err

# --- CMake 生成文件 ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
build.ninja
rules.ninja
.ninja_*
_deps/
compile_commands.json
.ctest
CTestTestfile.cmake
.cmake/api/

# --- Qt 自动生成 ---
moc_*.cpp
ui_*.h
qrc_*.cpp

# --- 用户本地配置 ---
CMakeUserPresets.json

# --- IDE/编辑器 ---
.trae/
.idea/
.vscode/
*.swp
*.swo
*~

# --- 日志/临时输出 ---
*.log
# 注：不再使用 *.txt 通配忽略，避免误伤测试数据等文本文件。
# CMake 生成文件已由上方 CMakeCache.txt / CMakeFiles/ 等规则覆盖。

# --- 文档生成 ---
docs/api/

# --- 杂项 ---
nul
