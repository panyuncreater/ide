# ============================================================
# fuzz_parser.dict — libFuzzer 词典（MiniLang 前端）
# ------------------------------------------------------------
# 作用：为 coverage-guided fuzzing 提供高价值 token 片段，帮助 fuzzer
#       更快拼出能深入 Parser 的结构（关键字/运算符/成对括号/插值边界）。
# 用法：run_fuzz.sh / build_fuzz.sh 通过 -dict=fuzz_parser.dict 传入。
# 格式：libFuzzer 词典格式，每行 name="value"（name 可省略），# 为注释。
#       控制字符用 \xNN 转义，引号/反斜杠用 \" \\。
# 关键字来源：lexer/Lexer.cpp kSortedKeywords（单一真相源）。
# ============================================================

# ---- 关键字 ----
kw_and="and"
kw_array="array"
kw_as="as"
kw_async="async"
kw_await="await"
kw_bool="bool"
kw_break="break"
kw_case="case"
kw_catch="catch"
kw_class="class"
kw_const="const"
kw_continue="continue"
kw_default="default"
kw_dict="dict"
kw_else="else"
kw_enum="enum"
kw_export="export"
kw_extends="extends"
kw_false="false"
kw_finally="finally"
kw_float="float"
kw_for="for"
kw_from="from"
kw_fun="fun"
kw_func="func"
kw_function="function"
kw_if="if"
kw_import="import"
kw_int="int"
kw_macro="macro"
kw_match="match"
kw_not="not"
kw_null="null"
kw_or="or"
kw_print="print"
kw_return="return"
kw_string="string"
kw_super="super"
kw_throw="throw"
kw_trait="trait"
kw_true="true"
kw_try="try"
kw_var="var"
kw_while="while"
kw_with="with"
kw_yield="yield"

# ---- 双字符运算符 / 箭头 ----
op_eq="=="
op_ne="!="
op_le="<="
op_ge=">="
op_arrow_fat="=>"
op_arrow_thin="->"
op_and="&&"
op_or="||"

# ---- 单字符运算符 / 分隔符 ----
op_assign="="
op_lt="<"
op_gt=">"
op_plus="+"
op_minus="-"
op_star="*"
op_slash="/"
op_percent="%"
op_bang="!"
op_amp="&"
op_pipe="|"
op_lparen="("
op_rparen=")"
op_lbrace="{"
op_rbrace="}"
op_lbracket="["
op_rbracket="]"
op_semi=";"
op_comma=","
op_colon=":"
op_question="?"
op_dot="."

# ---- 字符串 / 插值 / 转义边界（前端高频脆弱点）----
str_quote="\""
str_interp_open="{"
str_interp_close="}"
esc_newline="\\n"
esc_tab="\\t"
esc_hex="\\x"
esc_unicode="\\u{"
comment_line="//"
comment_block_open="/*"
comment_block_close="*/"

# ---- 常见成对/惯用片段（加速构造合法结构）----
frag_fun_hdr="fun f("
frag_class_hdr="class C {"
frag_if="if ("
frag_while="while ("
frag_for="for ("
frag_print="print("
frag_var="var x = "
frag_macro_call="!("
frag_match="match x {"
frag_case="case _ =>"
frag_import="import \""
frag_typed_arr="int[]"
