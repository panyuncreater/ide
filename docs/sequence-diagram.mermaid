sequenceDiagram
    participant User
    participant Interpreter
    participant Environment
    participant Value
    participant Compiler
    participant VM
    participant BytecodeChunk

    %% ============================================================
    %% 场景1: 闭包 — 函数定义与调用
    %% ============================================================
    rect rgb(240, 248, 255)
        Note over User, BytecodeChunk: 场景1: 闭包 — 函数定义与调用

        User->>Interpreter: fun makeCounter(): int { ... }
        Interpreter->>Interpreter: visitFunDecl(FunDecl)
        Interpreter->>Value: makeClosure("makeCounter", currentEnv_, params)
        Value-->>Interpreter: closureValue
        Interpreter->>Environment: define("makeCounter", closureValue)
        Note right of Environment: 闭包值捕获定义时环境

        User->>Interpreter: var counter = makeCounter()
        Interpreter->>Interpreter: visitFunCall(FunCall)
        Interpreter->>Environment: get("makeCounter")
        Environment-->>Interpreter: closureValue
        Interpreter->>Value: isClosure() → true
        Interpreter->>Value: closureEnv (定义时环境)
        Note right of Interpreter: 关键：使用 closureEnv 而非 currentEnv_
        Interpreter->>Environment: new Environment(closureValue.closureEnv)
        Note right of Environment: 新环境以闭包环境为父级
        Interpreter->>Environment: define("count", Value(0))
        Interpreter->>Interpreter: evaluate(funDecl->body)
        Interpreter-->>User: 返回闭包（内部函数）
    end

    %% ============================================================
    %% 场景2: VM 调用帧 — OP_CALL 完整流程
    %% ============================================================
    rect rgb(255, 248, 240)
        Note over User, BytecodeChunk: 场景2: VM 调用帧 — OP_CALL 完整流程

        User->>Compiler: compile(AST)
        Compiler->>Compiler: compileFunDecl(FunDecl)
        Compiler->>BytecodeChunk: 创建 subChunk(name="add", arity=2)
        Compiler->>BytecodeChunk: 编译函数体到 subChunk
        Compiler->>BytecodeChunk: subChunk.writeOp(OP_RETURN)
        Compiler->>Compiler: functionChunks_["add"] = subChunk
        Compiler->>BytecodeChunk: mainChunk: OP_NULL, OP_DEFINE_VAR "add"
        Compiler->>BytecodeChunk: mainChunk: OP_CLOSURE nameIdx=0, argCount=2
        Compiler-->>User: CompileResult{mainChunk, functionChunks}

        User->>VM: execute(compileResult)
        VM->>VM: functionChunks_ = compileResult.functionChunks

        Note over VM: 执行到 OP_CLOSURE
        VM->>Value: makeClosure("add", ..., params)
        VM->>VM: push(closureValue)

        Note over VM: 执行到 OP_CALL (argCount=2)
        VM->>VM: pop callee (closureValue)
        VM->>VM: functionChunks_["add"] → targetChunk
        VM->>VM: 检查 arity == argCount
        VM->>VM: 创建 VMCallFrame {chunk=targetChunk, ip=当前ip, basePointer=stack_.size()-2}
        VM->>VM: frames_.push_back(frame)
        VM->>VM: ip = 0 (跳转到函数字节码起始)

        Note over VM: 执行函数体
        VM->>VM: OP_GET_LOCAL slot=0 (读取参数 a)
        VM->>VM: OP_GET_LOCAL slot=1 (读取参数 b)
        VM->>VM: OP_ADD
        VM->>VM: OP_RETURN

        Note over VM: OP_RETURN 处理
        VM->>VM: pop 返回值 result
        VM->>VM: frame = frames_.back()
        VM->>VM: 截断栈到 frame.basePointer
        VM->>VM: push(result)
        VM->>VM: ip = frame.ip (恢复调用者位置)
        VM->>VM: frames_.pop_back()
    end

    %% ============================================================
    %% 场景3: 索引赋值 — 嵌套链式赋值
    %% ============================================================
    rect rgb(240, 255, 240)
        Note over User, BytecodeChunk: 场景3: 索引赋值 — obj.field[i] = val

        User->>Interpreter: obj.field[i] = val
        Interpreter->>Interpreter: visitIndexAssign(IndexAssign)
        Interpreter->>Interpreter: evaluate(node.index) → idxValue
        Interpreter->>Interpreter: evaluate(node.value) → valValue

        Note over Interpreter: object 是 MemberAccess
        Interpreter->>Interpreter: evaluate(MemberAccess.object) → objValue
        Interpreter->>Interpreter: evaluate(MemberAccess) → fieldValue

        Interpreter->>Interpreter: 修改 fieldValue: fieldValue[idx] = val

        Note over Interpreter: writeBack 递归
        Interpreter->>Interpreter: writeBack(MemberAccess, modifiedFieldValue)
        Interpreter->>Interpreter: objValue.fields["field"] = modifiedFieldValue
        Interpreter->>Interpreter: writeBack(VarRef "obj", modifiedObjValue)
        Interpreter->>Environment: set("obj", modifiedObjValue)
        Environment-->>Interpreter: true
    end

    %% ============================================================
    %% 场景4: 运行时类型检查
    %% ============================================================
    rect rgb(255, 240, 255)
        Note over User, BytecodeChunk: 场景4: 运行时类型检查

        User->>Interpreter: var x: int = "hello"
        Interpreter->>Interpreter: visitVarDecl(VarDecl)
        Interpreter->>Interpreter: evaluate(initializer) → Value("hello")
        Interpreter->>Interpreter: typeAnnotation = "int" (非空)
        Interpreter->>Interpreter: checkType(Value("hello"), "int", ...)
        Interpreter->>Interpreter: typeMatch: "hello".isInt() → false
        Interpreter-->>User: RuntimeError: 变量 x 的类型期望 int，实际为 string

        User->>Interpreter: var y: float = 42
        Interpreter->>Interpreter: visitVarDecl(VarDecl)
        Interpreter->>Interpreter: evaluate(initializer) → Value(42)
        Interpreter->>Interpreter: checkType(Value(42), "float", ...)
        Interpreter->>Interpreter: typeMatch: 42.isFloat() → false, 42.isInt() → true
        Note right of Interpreter: int 可隐式提升为 float
        Interpreter->>Environment: define("y", Value(42))
    end
