// builtins_demo.mini - 内置函数与标准库演示
// 覆盖特性：len / type / str / int / range / sum / abs / min / max
// 注意：float(x) 与 bool(x) 不是可调用转换函数，
//       只有 int() 与 str() 可转换；运行时转换请使用 str()。
// ============================================================

print("=== 类型与转换 ===");
print("type(42) = {type(42)}");
print("type('hi') = {type("hi")}");
print("type([1, 2]) = {type([1, 2])}");
print("str(42) = {str(42)}");
print("int('123') = {int("123")}");
print("int(3.9) = {int(3.9)}");

print("");
print("=== 数值内置 ===");
print("abs(-7) = {abs(-7)}");
print("min(3, 8) = {min(3, 8)}");
print("max(3, 8) = {max(3, 8)}");

print("");
print("=== 序列内置 ===");
var nums = [10, 20, 30];
print("len(nums) = {len(nums)}");
print("sum(nums) = {sum(nums)}");
var r = range(5);
print("range(5) = {r}");
print("sum(range(5)) = {sum(range(5))}");
