// fibonacci.mini - 斐波那契数列
// 覆盖特性：函数定义（fun）、递归调用、int 类型注解、循环
// ============================================================

// 递归方式计算斐波那契数
fun fibRecursive(n) {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    return fibRecursive(n - 1) + fibRecursive(n - 2);
}

// 迭代方式计算斐波那契数，使用 int 类型注解
int fibIterative(int n) {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    var a = 0;
    var b = 1;
    for (var i = 2; i <= n; i = i + 1) {
        var temp = a + b;
        a = b;
        b = temp;
    }
    return b;
}

// 打印前 10 个斐波那契数
print("=== 递归方式 ===");
for (var i = 0; i < 10; i = i + 1) {
    print("fib({i}) = {fibRecursive(i)}");
}

print("");
print("=== 迭代方式 ===");
for (var i = 0; i < 10; i = i + 1) {
    print("fib({i}) = {fibIterative(i)}");
}

// 预期输出：
// === 递归方式 ===
// fib(0) = 0
// fib(1) = 1
// fib(2) = 1
// fib(3) = 2
// fib(4) = 3
// fib(5) = 5
// fib(6) = 8
// fib(7) = 13
// fib(8) = 21
// fib(9) = 34
//
// === 迭代方式 ===
// fib(0) = 0
// fib(1) = 1
// fib(2) = 1
// fib(3) = 2
// fib(4) = 3
// fib(5) = 5
// fib(6) = 8
// fib(7) = 13
// fib(8) = 21
// fib(9) = 34
