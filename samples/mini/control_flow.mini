// control_flow.mini - 控制流演示
// 覆盖特性：if/else 分支、while 循环、for 循环、break/continue、
//           and/or 逻辑短路、嵌套控制流
// ============================================================

// ---- if/else 分支 ----
print("=== if/else ===");
var score = 85;
if (score >= 90) {
    print("Grade: A");
} else if (score >= 80) {
    print("Grade: B");
} else if (score >= 70) {
    print("Grade: C");
} else {
    print("Grade: F");
}

// ---- while 循环 ----
print("");
print("=== while 循环 ===");
var n = 1;
while (n <= 64) {
    print("{n}");
    n = n * 2;
}

// ---- for 循环 ----
print("");
print("=== for 循环 ===");
var sum = 0;
for (var i = 1; i <= 100; i = i + 1) {
    sum = sum + i;
}
print("sum(1..100) = {sum}");

// ---- break/continue ----
print("");
print("=== break/continue ===");
// 找出第一个能被 7 整除的大于 50 的数
var found = 0;
for (var i = 51; i < 200; i = i + 1) {
    if (i % 7 == 0) {
        found = i;
        break;
    }
}
print("first multiple of 7 after 50: {found}");

// continue：跳过偶数，只打印奇数
print("odd numbers 1-15:");
var odds = "";
for (var i = 1; i <= 15; i = i + 1) {
    if (i % 2 == 0) {
        continue;
    }
    odds = odds + i + " ";
}
print(odds);

// ---- and/or 逻辑短路 ----
print("");
print("=== and/or 短路 ===");
var a = true;
var b = false;

// and: 第一个为 false 时不计算第二个
print("true and true = {a and a}");
print("true and false = {a and b}");
print("false and true = {b and a}");

// or: 第一个为 true 时不计算第二个
print("true or false = {a or b}");
print("false or true = {b or a}");
print("false or false = {b or b}");

// 短路实际应用：避免除零
print("");
print("=== 短路保护 ===");
var divisor = 0;
var value = 10;
if (divisor != 0 and value / divisor > 5) {
    print("result > 5");
} else {
    print("divisor is zero or result <= 5");
}

// 预期输出：
// === if/else ===
// Grade: B
//
// === while 循环 ===
// 1
// 2
// 4
// 8
// 16
// 32
// 64
//
// === for 循环 ===
// sum(1..100) = 5050
//
// === break/continue ===
// first multiple of 7 after 50: 56
// odd numbers 1-15:
// 1 3 5 7 9 11 13 15
//
// === and/or 短路 ===
// true and true = true
// true and false = false
// false and true = false
// true or false = true
// false or true = true
// false or false = false
//
// === 短路保护 ===
// divisor is zero or result <= 5
