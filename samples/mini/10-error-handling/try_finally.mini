// try_finally.mini - try/finally 与 finally 演示
// 覆盖特性：try/catch/finally 组合、仅 try/finally（无 catch）、
//           finally 无论是否发生异常都会执行
// ============================================================

fun riskyDivide(a, b) {
    if (b == 0) {
        throw "DivisionByZero";
    }
    return a / b;
}

print("=== try / catch / finally（正常路径）===");
try {
    print("result = {riskyDivide(10, 2)}");
} catch (e) {
    print("caught: {e}");
} finally {
    print("finally ran (normal path)");
}

print("");
print("=== try / catch / finally（异常路径）===");
try {
    print("result = {riskyDivide(10, 0)}");
} catch (e) {
    print("caught: {e}");
} finally {
    print("finally ran (exception path)");
}

print("");
print("=== 仅 try / finally（无 catch）===");
try {
    print("doing work...");
} finally {
    print("cleanup always runs");
}

print("");
print("done.");
