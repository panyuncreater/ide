// object_fields.mini - 对象字段与成员赋值演示
// 覆盖特性：成员赋值 obj.field = value、构造后修改字段、
//           嵌套对象成员访问与赋值
// ============================================================

class Counter {
    fun init(start) {
        this.count = start;
    }
    fun tick() {
        this.count = this.count + 1;
        return this.count;
    }
}

var c = Counter(10);
print("initial count = {c.count}");
print("after tick = {c.tick()}");

// 构造后通过成员赋值直接修改字段
c.count = 99;
print("after member assign = {c.count}");

// 嵌套对象：对深层字段成员赋值
class Box {
    fun init() {
        this.inner = Counter(0);
    }
}
var box = Box();
box.inner.count = 5;
print("box.inner.count = {box.inner.count}");
