// higher_order.mini - 高阶函数演示
// 覆盖特性：函数作为一等公民、回调传递、闭包捕获、
//           函数赋值给变量、函数作为参数/返回值
// ============================================================

// 函数作为参数（回调模式）
fun applyTwice(f, x) {
    return f(f(x));
}

fun double(n) {
    return n * 2;
}

fun addOne(n) {
    return n + 1;
}

// 函数作为返回值（闭包工厂）
fun makeAdder(amount) {
    fun adder(x) {
        return x + amount;
    }
    return adder;
}

// 闭包：内部函数捕获外部变量
fun makeCounter() {
    var count = 0;
    fun increment() {
        count = count + 1;
        return count;
    }
    return increment;
}

// ---- 函数作为参数 ----
print("=== 函数作为参数 ===");
print("applyTwice(double, 3) = {applyTwice(double, 3)}");
print("applyTwice(addOne, 10) = {applyTwice(addOne, 10)}");

// ---- 函数赋值给变量 ----
print("");
print("=== 函数赋值给变量 ===");
fun greet(name) { return "Hi, " + name + "!"; }
print(greet("Alice"));
print(greet("Bob"));

// ---- 闭包工厂 ----
print("");
print("=== 闭包工厂 ===");
var add5 = makeAdder(5);
var add10 = makeAdder(10);
print("add5(20) = {add5(20)}");
print("add10(20) = {add10(20)}");

// ---- 计数器闭包 ----
print("");
print("=== 计数器闭包 ===");
var counter = makeCounter();
print("call 1: {counter()}");
print("call 2: {counter()}");
print("call 3: {counter()}");

// 预期输出：
// === 函数作为参数 ===
// applyTwice(double, 3) = 12
// applyTwice(addOne, 10) = 12
//
// === 函数赋值给变量 ===
// Hi, Alice!
// Hi, Bob!
//
// === 闭包工厂 ===
// add5(20) = 25
// add10(20) = 30
//
// === 计数器闭包 ===
// call 1: 1
// call 2: 2
// call 3: 3
