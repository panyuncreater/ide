// math_utils.mini - 数学工具模块
export fun add(a, b) {
    return a + b;
}

export fun multiply(a, b) {
    return a * b;
}

export fun factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

export fun fibonacci(n) {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    var a = 0;
    var b = 1;
    for (var i = 2; i <= n; i = i + 1) {
        var temp = a + b;
        a = b;
        b = temp;
    }
    return b;
}

export var PI = 3.14159265359;
