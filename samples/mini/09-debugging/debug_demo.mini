// debug_demo.mini - 调试功能综合演示
// 覆盖调试操作：
//   普通断点、条件断点、单步进入 (F11)、单步跳过 (F10)、
//   单步跳出 (Shift+F11)、继续 (F9)、停止 (Shift+F5)
// 覆盖调试面板：
//   变量监视（全局/局部/闭包作用域）、调用栈、VM 栈状态
// 语言特性覆盖：
//   全局变量、函数调用链、递归、循环、条件断点、闭包捕获、
//   变量遮蔽、class 方法调用
// ============================================================
//
// 调试练习指南：
//
// 1. 按 F6 启动调试
// 2. 在 enterFuncA 调用处（第 122 行）设普通断点 -> 观察调用栈 + 局部变量
// 3. F10 单步跳过 enterFuncB -> F11 单步进入 enterFuncB -> Shift+F11 步出
// 4. 在 fib 函数首行（第 50 行）设条件断点 n == 4 -> F9 继续，观察停在 n==4
// 5. 在 loopDemo 的 for 行（第 58 行）设条件断点 i == 7 -> 观察变量面板中 i 的值
// 6. 在闭包体内（第 67 行）设断点 -> 观察闭包作用域 "外层" 中的 amount
// 7. 在 addTen(5)（第 141 行）F11 步入 -> 观察三层作用域：全局 / 局部 / 外层
// 8. 在 scopeA()（第 147 行）F11 步入 -> 逐层深入观察变量遮蔽
// 9. 在 p1.distanceTo(p2)（第 155 行）F11 步入 -> 观察 this 和调用栈
//
// ============================================================

// ---- 全局变量（调试面板 "全局作用域" 可见）----
string title = "Debug Demo";
int version = 1;

// ---- 1. 函数调用链 —— 演示单步进入 / 跳过 / 跨出 ----
fun enterFuncA(x) {
    var a = x * 2;
    var b = enterFuncB(a);
    return b + 1;
}

fun enterFuncB(x) {
    var a = x + 10;
    var c = enterFuncC(a);
    return c;
}

fun enterFuncC(x) {
    var result = x * x;
    return result;
}

// ---- 2. 递归 —— 演示调用栈增长与收缩 ----
fun fib(n) {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    return fib(n - 1) + fib(n - 2);
}

// ---- 3. 循环 + 条件断点 ----
fun loopDemo() {
    var sum = 0;
    for (var i = 0; i < 10; i = i + 1) {
        sum = sum + i * i;
    }
    return sum;
}

// ---- 4. 闭包 —— 演示闭包作用域（"外层"）----
fun makeAdder(amount) {
    fun adder(x) {
        var result = x + amount;
        return result;
    }
    return adder;
}

// ---- 5. 多层嵌套作用域 + 变量遮蔽 ----
fun scopeA() {
    var x = 100;
    var y = 200;
    var z = scopeB(x);
    return z;
}

fun scopeB(x) {
    var y = x + 50;
    var z = scopeC(x, y);
    return z;
}

fun scopeC(x, y) {
    var local = x + y;
    return local;
}

// ---- 6. 类方法调用 —— 演示 this 引用与调用栈 ----
class Point {
    fun init(x, y) {
        this.x = x;
        this.y = y;
    }

    fun distanceTo(other) {
        var dx = abs(this.x - other.x);
        var dy = abs(this.y - other.y);
        var d = dx + dy;
        return d;
    }

    fun describe() {
        return "(" + str(this.x) + ", " + str(this.y) + ")";
    }
}

// ---- 主流程 ----
fun debugMain() {
    print("=== 调试功能演示 ===");
    print("");

    // 1) 全局变量已在面板中可见
    print("title = {title}, version = {version}");
    print("");

    // 2) 函数调用链：F10 跳过 / F11 进入 / Shift+F11 步出
    print("--- 单步调试 ---");
    var chain = enterFuncA(3);
    print("chain result = {chain}");
    print("");

    // 3) 递归：观察调用栈深度增长
    print("--- 递归调用栈 ---");
    var f6 = fib(6);
    print("fib(6) = {f6}");
    print("");

    // 4) 循环：在 for 行设条件断点 i == 7
    print("--- 条件断点 ---");
    var loopSum = loopDemo();
    print("loop sum = {loopSum}");
    print("");

    // 5) 闭包：观察 "外层" 作用域中的 amount
    print("--- 闭包作用域 ---");
    var addTen = makeAdder(10);
    var r = addTen(5);
    print("addTen(5) = {r}");
    print("");

    // 6) 多层嵌套：逐层步入观察变量遮蔽
    print("--- 作用域遮蔽 ---");
    var scopeResult = scopeA();
    print("scopeA() = {scopeResult}");
    print("");

    // 7) 类方法：步入 distanceTo 观察 this
    print("--- 类方法调用 ---");
    var p1 = Point(1, 2);
    var p2 = Point(4, 6);
    var dist = p1.distanceTo(p2);
    print("{p1.describe()} -> {p2.describe()} dist = {dist}");
}

debugMain();

// 预期输出：
// === 调试功能演示 ===
//
// title = Debug Demo, version = 1
//
// --- 单步调试 ---
// chain result = 257
//
// --- 递归调用栈 ---
// fib(6) = 8
//
// --- 条件断点 ---
// loop sum = 285
//
// --- 闭包作用域 ---
// addTen(5) = 15
//
// --- 作用域遮蔽 ---
// scopeA() = 250
//
// --- 类方法调用 ---
// (1, 2) -> (4, 6) dist = 7
