// comments_demo.mini - 注释演示
// 覆盖特性：行注释 // 、块注释 /* */（支持嵌套）
// ============================================================

// 这是一行行注释
var a = 1;   // 行尾也可以写注释

/* 这是一段块注释
   可以跨越多行
   var hidden = 2;   // 块注释内的代码不会被执行
*/

/* 嵌套块注释：/* 内层 */ 也被整体忽略 */
var b = 2;

print("a = {a}");
print("b = {b}");
