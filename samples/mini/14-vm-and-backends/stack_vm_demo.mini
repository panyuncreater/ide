// 栈式 VM 演示：观察 push/pop 操作
// 在「字节码轨迹面板」中单步执行，观察栈变化

var x = 1 + 2;        // OP_INT 1, OP_INT 2, OP_ADD, OP_DEFINE_VAR
var y = x * 3;        // OP_GET_VAR, OP_INT 3, OP_MUL, OP_DEFINE_VAR
print(y);              // OP_GET_VAR, OP_PRINT → 输出 9

// 嵌套表达式：栈深度变化更明显
var z = (1 + 2) * (3 + 4);
print(z);              // 21

// 函数调用：栈帧 push/pop
fun double(n) {
    return n * 2;
}
print(double(5));      // 10
