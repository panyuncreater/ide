// functions_advanced.mini - 函数进阶特性
// 覆盖特性：默认参数（字面量）、链式调用 f(x)(y)
// 注意：默认参数必须是字面量（数字 / 字符串 / 布尔 / null / 负数），
//       且一旦出现默认参数，其后所有参数也必须有默认值。
// ============================================================

// 1) 默认参数（字符串字面量）
fun greet(name = "World", punct = "!") {
    return "Hello, " + name + punct;
}
print(greet());                 // Hello, World!
print(greet("Alice"));         // Hello, Alice!
print(greet("Bob", "?"));     // Hello, Bob?

// 2) 默认参数（数字字面量）
fun power(base, exp = 2) {
    var r = 1;
    for (var i = 0; i < exp; i = i + 1) {
        r = r * base;
    }
    return r;
}
print("power(3) = {power(3)}");         // 9
print("power(3, 3) = {power(3, 3)}"); // 27

// 3) 链式调用 f(x)(y)：函数返回函数后直接调用
fun adderFactory(amount) {
    fun adder(x) {
        return x + amount;
    }
    return adder;
}
print("adderFactory(10)(5) = {adderFactory(10)(5)}");  // 15
