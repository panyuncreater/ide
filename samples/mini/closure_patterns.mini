// 闭包模式集锦：配合「闭包检查器面板」学习

// 1. 计数器模式（私有状态）
fun makeCounter() {
    var count = 0;
    return fun() {
        count = count + 1;
        return count;
    };
}
var counter = makeCounter();
print(counter());      // 1
print(counter());      // 2
print(counter());      // 3

// 2. 函数工厂
fun multiplier(factor) {
    return fun(x) { return x * factor; };
}
var triple = multiplier(3);
print(triple(7));      // 21

// 3. 循环中的闭包陷阱
var fns = [];
for (var i = 0; i < 3; i = i + 1) {
    fns.push(fun() { return i; });
}
// 所有闭包共享同一个 i，输出都是 3
print(fns[0]());       // 3
print(fns[1]());       // 3
print(fns[2]());       // 3
