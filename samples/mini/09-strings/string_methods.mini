// string_methods.mini - 字符串方法演示
// 覆盖特性：转义序列、upper/lower、substr、indexOf、
//           contains/starts_with/ends_with、replace/split/trim、
//           字符索引 s[i]
// ============================================================

print("=== 转义序列 ===");
print("line1\nline2");           // \n 换行
print("col1\tcol2");            // \t 制表符
print("quote: \"hi\"");          // \" 双引号
print("backslash: \\");          // \\ 反斜杠

var s = "Hello, MiniLang";
print("");
print("=== 大小写 ===");
print("upper: {s.upper()}");
print("lower: {s.lower()}");

print("");
print("=== 子串与查找 ===");
print("substr(0,5): {s.substr(0, 5)}");
print("substr(7): {s.substr(7)}");
print("indexOf('Mini'): {s.indexOf("Mini")}");
print("contains('Lang'): {s.contains("Lang")}");
print("starts_with('Hello'): {s.starts_with("Hello")}");
print("ends_with('Lang'): {s.ends_with("Lang")}");

print("");
print("=== 替换 / 分割 / 裁剪 ===");
var messy = "  hello world  ";
print("trim: '{messy.trim()}'");
print("replace: {messy.replace("world", "MiniLang")}");
var csv = "a,b,c";
print("split(','): {csv.split(",")}");

print("");
print("=== 字符索引 ===");
var word = "abcde";
print("word[0] = {word[0]}");
print("word[2] = {word[2]}");
