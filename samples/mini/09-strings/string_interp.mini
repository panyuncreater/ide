// string_interp.mini - 字符串插值深入演示
// 覆盖特性：字符串插值嵌套、表达式插值、类型自动转换、
//           插值中的运算、嵌套字符串
// ============================================================

var name = "MiniLang";
var year = 2026;
var pi = 3.14159;
var flag = true;

// 基础插值：变量、表达式、运算
print("=== 基础插值 ===");
print("Language: {name}");
print("Year: {year}");
print("Next year: {year + 1}");
print("Pi rounded: {pi}");

// 表达式插值：算术运算、比较
print("");
print("=== 表达式插值 ===");
print("2 + 3 = {2 + 3}");
print("10 * 5 = {10 * 5}");
print("year > 2025 = {year > 2025}");
print("flag = {flag}");

// 类型自动转换：int/float/bool/null 自动转为字符串
print("");
print("=== 类型转换 ===");
var intVal = 42;
var floatVal = 2.718;
var boolVal = false;
var nullVal = null;
print("int: {intVal}");
print("float: {floatVal}");
print("bool: {boolVal}");
print("null: {nullVal}");

// 数组和字典的插值
print("");
print("=== 复杂类型 ===");
var arr = [1, 2, 3];
var dict = {"key": "value"};
print("array: {arr}");
print("dict: {dict}");
print("array len: {arr.len()}");

// 字符串拼接 vs 插值对比
print("");
print("=== 拼接 vs 插值 ===");
print("Concat: " + name + " has " + name.len() + " chars");
print("Interp: {name} has {name.len()} chars");

// 预期输出：
// === 基础插值 ===
// Language: MiniLang
// Year: 2026
// Next year: 2027
// Pi rounded: 3.14159
//
// === 表达式插值 ===
// 2 + 3 = 5
// 10 * 5 = 50
// year > 2025 = true
// flag = true
//
// === 类型转换 ===
// int: 42
// float: 2.718
// bool: false
// null: null
//
// === 复杂类型 ===
// array: [1, 2, 3]
// dict: {key: value}
// array len: 3
//
// === 拼接 vs 插值 ===
// Concat: MiniLang has 8 chars
// Interp: MiniLang has 8 chars
