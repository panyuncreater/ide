###############################################################################
# MiniLang IDE .gitattributes
###############################################################################

# 默认：文本文件自动规范化换行符
* text=auto

# C/C++ 源码
*.c      text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf

# CMake
CMakeLists.txt       text eol=lf
*.cmake              text eol=lf
CMakePresets.json    text eol=lf

# Markdown / 文档
*.md     text eol=lf diff=markdown
*.txt    text eol=lf

# 脚本
*.bat    text eol=crlf
*.ps1    text eol=crlf
*.sh     text eol=lf

# 配置文件
.gitignore        text eol=lf
.gitattributes    text eol=lf
.editorconfig     text eol=lf
.clang-format     text eol=lf
.clang-tidy       text eol=lf
Doxyfile          text eol=lf
LICENSE           text eol=lf
*.json            text eol=lf
*.yaml            text eol=lf
*.yml             text eol=lf

# Qt 资源
*.qrc   text eol=lf

# 二进制
*.dll   binary
*.exe   binary
*.obj   binary
*.lib   binary
*.pdb   binary
*.png   binary
*.ico   binary
*.ppm   binary
