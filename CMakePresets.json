{
  "version": 6,
  "configurePresets": [
    {
      "hidden": true,
      "name": "Qt",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}"
      },
      "vendor": {
        "qt-project.org/Qt": {
          "checksum": "wVa86FgEkvdCTVp1/nxvrkaemJc="
        }
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug (Ninja)",
      "description": "MSVC + Ninja Debug 构建（/W4 + /WX 零警告基线）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/debug",
      "inherits": "Qt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MINILANG_W4": "ON",
        "MINILANG_WERROR": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release (Ninja)",
      "description": "MSVC + Ninja Release 构建（含 LTO）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/release",
      "inherits": "Qt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MINILANG_W4": "ON",
        "MINILANG_WERROR": "ON",
        "MINILANG_ENABLE_LTO": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows MSVC Debug + ASan (Ninja)",
      "description": "MSVC + Ninja Debug 构建，启用 Address Sanitizer（修复问题 8）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/asan",
      "inherits": "Qt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MINILANG_SANITIZE": "address"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-vs",
      "displayName": "Windows MSVC Debug (VS IDE)",
      "description": "Visual Studio 2022 多配置生成器，用于 IDE 打开",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/out/build/vs",
      "inherits": "Qt",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug (Ninja)",
      "description": "GCC + Ninja Debug 构建（-Wall -Wextra -Wpedantic -Werror 零警告基线）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "MINILANG_WERROR": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release (Ninja)",
      "description": "GCC + Ninja Release 构建（含 LTO + Werror）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "MINILANG_WERROR": "ON",
        "MINILANG_ENABLE_LTO": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS Clang Debug (Ninja)",
      "description": "Clang + Ninja Debug 构建（-Wall -Wextra -Wpedantic -Werror 零警告基线）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/macos-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "MINILANG_WERROR": "ON",
        "CMAKE_C_USE_RESPONSE_FILE_FOR_OBJECTS": "OFF",
        "CMAKE_CXX_USE_RESPONSE_FILE_FOR_OBJECTS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-clang-release",
      "displayName": "macOS Clang Release (Ninja)",
      "description": "Clang + Ninja Release 构建（含 LTO + Werror）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "MINILANG_WERROR": "ON",
        "MINILANG_ENABLE_LTO": "ON",
        "CMAKE_C_USE_RESPONSE_FILE_FOR_OBJECTS": "OFF",
        "CMAKE_CXX_USE_RESPONSE_FILE_FOR_OBJECTS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-gcc-coverage",
      "displayName": "Linux GCC Debug + Coverage",
      "description": "GCC + Ninja Debug 构建，启用 --coverage 插桩（CI 覆盖率，修复审计问题 2）",
      "inherits": "linux-gcc-debug",
      "binaryDir": "${sourceDir}/out/build/linux-coverage",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "windows-msvc-debug",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "jobs": 4,
        "timeout": 300
      }
    },
    {
      "name": "release",
      "configurePreset": "windows-msvc-release",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "jobs": 4,
        "timeout": 300
      }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "jobs": 4,
        "timeout": 300
      }
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "jobs": 4,
        "timeout": 300
      }
    },
    {
      "name": "macos-clang-debug",
      "configurePreset": "macos-clang-debug",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "jobs": 4,
        "timeout": 300
      }
    },
    {
      "name": "macos-clang-release",
      "configurePreset": "macos-clang-release",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "jobs": 4,
        "timeout": 300
      }
    },
    {
      "name": "linux-gcc-coverage",
      "configurePreset": "linux-gcc-coverage",
      "output": {
        "outputOnFailure": true,
        "verbosity": "default"
      },
      "execution": {
        "jobs": 4,
        "timeout": 300
      }
    }
  ],
  "vendor": {
    "qt-project.org/Presets": {
      "checksum": "67SmY24ZeVbebyKD0fGfIzb/bGI="
    }
  }
}
