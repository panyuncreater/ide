/* ============================================================
 * Solarized Light Theme (Ethan Schoonover)
 * Base3: #FDF6E3  Base2: #EEE8D5  Base01: #586E75
 * Accent: blue #268BD2  green #859900  yellow #B58900
 * This file is a DESIGN REFERENCE only — not loaded at runtime.
 * Active styling is in ide.cpp::applyFluentStyle() + TeachingTheme.h.
 * ============================================================ */

/* ============================================================
   MiniLang IDE — Light Theme (Modernized)
   Palette: Soft neutral grays + refined blue accent
   Canvas: #fafafa / Sidebar: #f3f3f3 / Hairline: #e8e8e8
   Text: #1e1e1e / #5a5a5a / #8c8c8c
   Accent: #0078d4 (primary) / #106ebe (active) / #005a9e (run)
   ============================================================ */

/* ---- Global ---- */
QMainWindow {
    background-color: #fafafa;
}
QWidget {
    font-family: "Segoe UI", "Microsoft YaHei", "SF Pro Text", -apple-system, sans-serif;
    font-size: 13px;
    color: #1e1e1e;
}
*:focus {
    outline: none;
}

/* ============================================================
   Title Bar (32px, seamless white, drag-move + window buttons)
   ============================================================ */

QWidget#titleBar {
    background: #fafafa;
    border: none;
    border-bottom: 1px solid #e8e8e8;
}
QLabel#titleText {
    color: #1e1e1e;
    font-size: 12px;
    font-weight: 600;
    padding: 0 4px 0 6px;
}
QLabel#titlePath {
    color: #8c8c8c;
    font-size: 11px;
    padding: 0 4px;
}
QWidget#titleBar QToolButton {
    background: transparent;
    border: none;
    border-radius: 0;
    margin: 0;
    padding: 0;
    outline: none;
}
QWidget#titleBar QToolButton:hover {
    background: #e8e8e8;
}
QWidget#titleBar QToolButton:pressed {
    background: #d0d0d0;
}
QWidget#titleBar QToolButton#titleCloseBtn:hover {
    background: #e81123;
    color: #ffffff;
}
QWidget#titleBar QToolButton#titleCloseBtn:pressed {
    background: #c50f1f;
    color: #ffffff;
}

/* ============================================================
   Custom Menu Bar (28px, flat, hover soft-blue rounded bg)
   ============================================================ */

QMenuBar#customMenuBar {
    background: #fafafa;
    color: #1e1e1e;
    border: none;
    border-bottom: 1px solid #e8e8e8;
    padding: 0 4px;
    font-size: 13px;
    spacing: 2px;
}
QMenuBar#customMenuBar::item {
    padding: 4px 10px;
    background: transparent;
    border-radius: 4px;
    margin: 2px 0;
}
QMenuBar#customMenuBar::item:selected,
QMenuBar#customMenuBar::item:on {
    background: rgba(0, 120, 212, 16);
    color: #0078d4;
}
QMenuBar#customMenuBar::item:pressed {
    background: rgba(0, 120, 212, 28);
}

/* ============================================================
   Main Toolbar (36px, white, flat, refined spacing)
   ============================================================ */

QToolBar#mainToolbar {
    background: #fafafa;
    border: none;
    border-bottom: 1px solid #e8e8e8;
    spacing: 4px;
    padding: 2px 8px;
}
QToolBar#mainToolbar QToolButton {
    padding: 0;
    border: none;
    border-radius: 5px;
    background: transparent;
    color: #1e1e1e;
    font-size: 12px;
    outline: none;
    margin: 0 1px;
}
QToolBar#mainToolbar QToolButton:hover {
    background: rgba(0, 0, 0, 6);
    border: none;
}
QToolBar#mainToolbar QToolButton:pressed {
    background: rgba(0, 0, 0, 14);
}
QToolBar#mainToolbar QToolButton:disabled {
    color: #b0b0b0;
    background: transparent;
}
QToolBar#mainToolbar QToolButton:checked {
    background: rgba(0, 120, 212, 16);
    color: #0078d4;
    border: none;
}
QToolBar#mainToolbar QToolButton::menu-indicator {
    image: none;
    width: 0;
    height: 0;
}
QToolBar#mainToolbar::separator {
    background: #e0e0e0;
    width: 1px;
    height: 18px;
    margin: 0 6px;
}

/* ---- Dialog / MessageBox / Tooltip ---- */
QDialog {
    background-color: #ffffff;
    color: #1e1e1e;
}
QMessageBox {
    background-color: #ffffff;
    color: #1e1e1e;
}
QMessageBox QLabel {
    color: #1e1e1e;
}
QToolTip {
    background-color: #f9f9f9;
    color: #1e1e1e;
    border: 1px solid #e0e0e0;
    padding: 5px 9px;
    border-radius: 4px;
    font-size: 12px;
}

/* ---- Menu Bar (fallback) ---- */
QMenuBar {
    background: #fafafa;
    color: #1e1e1e;
    border-bottom: 1px solid #e8e8e8;
    padding: 3px 8px;
}
QMenuBar::item {
    padding: 5px 10px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: #e8e8e8;
}
QMenuBar::item:pressed {
    background: #d4d4d4;
}
QMenu {
    background: #ffffff;
    color: #1e1e1e;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 4px 0px;
}
QMenu::item {
    padding: 7px 28px 7px 18px;
    border: none;
    border-radius: 4px;
    margin: 0 4px;
    font-size: 13px;
}
QMenu::item:selected {
    background: #0078d4;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #b0b0b0;
}
QMenu::separator {
    height: 1px;
    background: #ececec;
    margin: 4px 10px;
}
QMenu#fileTreeMenu {
    background: #ffffff;
    color: #1e1e1e;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 4px 0px;
}
QMenu#fileTreeMenu::item:disabled {
    color: #b0b0b0;
}

/* ---- Toolbar (fallback) ---- */
QToolBar {
    background: #f3f3f3;
    border: none;
    border-bottom: 1px solid #e8e8e8;
    spacing: 4px;
    padding: 4px 8px;
}
QToolBar QToolButton {
    padding: 0;
    border: none;
    border-radius: 5px;
    background: transparent;
    color: #1e1e1e;
    font-size: 12px;
    outline: none;
}
QToolBar QToolButton:hover {
    background: rgba(0, 0, 0, 6);
    border: none;
}
QToolBar QToolButton:pressed {
    background: rgba(0, 0, 0, 14);
}
QToolBar QToolButton:disabled {
    color: #b0b0b0;
    background: transparent;
}
QToolBar QToolButton:checked {
    background: rgba(0, 120, 212, 16);
    color: #0078d4;
    border: none;
}
QToolBar QToolButton:checked:hover {
    background: rgba(0, 120, 212, 28);
}
QToolBar QToolButton::menu-indicator {
    image: none;
    width: 0;
    height: 0;
}
/* Run button */
QToolBar PushButton {
    background: #005a9e;
    color: #ffffff;
    border: none;
    padding: 5px 14px;
    font-weight: 600;
    border-radius: 5px;
}
QToolBar PushButton:hover {
    background: #106ebe;
}
QToolBar PushButton:pressed {
    background: #004c87;
}
QToolBar PushButton:disabled {
    background: #c8c8c8;
    color: #f0f0f0;
}
QToolBar SplitDropButton {
    background: #005a9e;
    border: none;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}
QToolBar SplitDropButton:hover {
    background: #106ebe;
}
QToolBar::separator {
    background: #e0e0e0;
    width: 1px;
    height: 1px;
    margin: 8px 4px;
}

/* ---- Debug/VM Button Containers ---- */
QWidget#debugButtonContainer,
QWidget#vmButtonContainer {
    background: transparent;
    border: none;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background: #f0f0f0;
}
QSplitter::handle:horizontal {
    width: 4px;
}
QSplitter::handle:vertical {
    height: 4px;
}
QSplitter::handle:hover {
    background: #0078d4;
}

/* ============================================================
   Welcome Page — centered, spacious, refined (Claude DS inspired)
   ============================================================ */

QWidget#welcomePage {
    background: #FFFFFF;
}
QWidget#welcomeRecentPanel {
    background: #F7F7F7;
    border-right: 1px solid #E8E8E8;
}
QLabel#welcomeRecentHeader {
    color: #5A5A5A;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    padding: 4px 16px 8px 16px;
}
QListWidget#welcomeRecentList {
    background: transparent;
    border: none;
    outline: none;
    padding: 0 8px;
}
QListWidget#welcomeRecentList::item {
    padding: 7px 12px;
    border-radius: 5px;
    color: #1E1E1E;
    font-size: 13px;
}
QListWidget#welcomeRecentList::item:hover {
    background: rgba(0,120,212,0.08);
}
QListWidget#welcomeRecentList::item:selected {
    background: #CCE4F7;
    color: #0078D4;
}
QWidget#welcomeCenter {
    background: #FFFFFF;
}
QLabel#welcomeIcon {
    qproperty-alignment: AlignCenter;
    min-width: 96px;
    min-height: 96px;
}
QLabel#welcomeTitle {
    color: #1E1E1E;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.5px;
}
QLabel#welcomeSubtitle {
    color: #5A5A5A;
    font-size: 14px;
    font-weight: 400;
}
QLabel#welcomeShortcut {
    color: #8a8578;
    font-size: 12px;
}
QLabel#welcomeShortcut:hover {
    color: #0078D4;
}
QPushButton#welcomePrimaryBtn {
    background: #0078D4;
    color: #ffffff;
    border: none;
    padding: 10px 32px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#welcomePrimaryBtn:hover {
    background: #106EBE;
}
QPushButton#welcomePrimaryBtn:pressed {
    background: #005A9E;
}
QPushButton#welcomePrimaryBtn:disabled {
    background: #c8c8c8;
    color: #f0f0f0;
}
QPushButton#welcomeSecondaryBtn {
    background: transparent;
    color: #1E1E1E;
    border: 1px solid #D4D4D4;
    padding: 10px 32px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
}
QPushButton#welcomeSecondaryBtn:hover {
    background: rgba(0,120,212,0.08);
    border-color: #0078D4;
    color: #0078D4;
}
QPushButton#welcomeSecondaryBtn:pressed {
    background: rgba(0,120,212,0.12);
}
QPushButton#welcomeSecondaryBtn:disabled {
    color: #b0b0b0;
    border-color: #e0e0e0;
}

QWidget#welcomeBtnContainer {
    background: transparent;
}
QLabel#welcomeShortcutHint {
    color: #8C8C8C;
    font-size: 11px;
    font-family: "Cascadia Code", "Consolas", monospace;
    background: rgba(0, 0, 0, 4);
    border: 1px solid #E8E8E8;
    border-radius: 4px;
    padding: 2px 8px;
}

/* ============================================================
   Activity Bar (left 32px icon strip)
   ============================================================ */

QFrame#ActivityBar {
    background: #f3f3f3;
    border: none;
    border-right: 1px solid #e8e8e8;
}

/* ---- Sidebar ---- */
QWidget#leftSidebar {
    background: #f3f3f3;
    border: none;
    border-right: 1px solid #e8e8e8;
}
QLabel#workspaceLabel {
    color: #5a5a5a;
    font-size: 11px;
    padding: 0px 4px;
}

/* ---- Panel Headers ---- */
QFrame#panelHeader {
    background: #f3f3f3;
    border: none;
    border-bottom: 1px solid #e8e8e8;
}
QLabel#panelHeaderLabel {
    color: #5a5a5a;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
}
QToolButton#panelToolBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #5a5a5a;
    font-size: 14px;
    font-weight: bold;
    padding: 3px;
}
QToolButton#panelToolBtn:hover {
    background: #e0e0e0;
    color: #1e1e1e;
}
QToolButton#panelToolBtn:pressed {
    background: #c8c8c8;
}
QToolButton#panelCloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #5a5a5a;
    font-size: 12px;
    padding: 3px 5px;
}
QToolButton#panelCloseBtn:hover {
    background: #e0e0e0;
    color: #1e1e1e;
}
QToolButton#panelCloseBtn:pressed {
    background: #c8c8c8;
}

/* ============================================================
   Tab Widget (Editor) — 36px flat tabs, accent top border
   ============================================================ */

QTabWidget#editorTabWidget::pane {
    border: none;
    border-top: 1px solid #e8e8e8;
    background: #ffffff;
}
QTabWidget#editorTabWidget QTabBar {
    background: #efefef;
    border-bottom: none;
}
QTabWidget#editorTabWidget QTabBar::tab {
    background: transparent;
    color: #8c8c8c;
    padding: 9px 14px 9px 12px;
    border: none;
    border-top: 2px solid transparent;
    min-width: 100px;
    max-width: 200px;
    font-size: 12px;
    margin: 0;
}
QTabWidget#editorTabWidget QTabBar::tab:selected {
    background: #ffffff;
    color: #1e1e1e;
    border-top: 2px solid #0078d4;
    font-weight: 500;
}
QTabWidget#editorTabWidget QTabBar::tab:hover:!selected {
    background: #e5e5e5;
    color: #1e1e1e;
}
QTabWidget#editorTabWidget QTabBar::close-button {
    subcontrol-position: right;
    border: none;
    border-radius: 3px;
    padding: 1px;
}
QTabWidget#editorTabWidget QTabBar::close-button:hover {
    background: #c8c8c8;
}
QTabWidget#editorTabWidget QTabBar::tab:!selected QTabBar::close-button {
    width: 0;
    height: 0;
    padding: 0;
    margin: 0;
    border: none;
}
QTabWidget#editorTabWidget QTabBar::tab:!selected:hover QTabBar::close-button {
    width: 16px;
    height: 16px;
    padding: 1px;
    margin: 1px;
}

/* ---- Tab Widget (Bottom/Right Panels) ---- */
QTabWidget#bottomTabWidget::pane,
QTabWidget#rightTabWidget::pane {
    border: none;
    background: #ffffff;
}
QTabWidget#bottomTabWidget QTabBar,
QTabWidget#rightTabWidget QTabBar {
    background: #f3f3f3;
    border-bottom: 1px solid #e8e8e8;
}
QTabWidget#bottomTabWidget QTabBar::tab,
QTabWidget#rightTabWidget QTabBar::tab {
    background: transparent;
    color: #8c8c8c;
    padding: 8px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}
QTabWidget#bottomTabWidget QTabBar::tab:selected,
QTabWidget#rightTabWidget QTabBar::tab:selected {
    color: #1e1e1e;
    border-bottom: 2px solid #0078d4;
    font-weight: 500;
}
QTabWidget#bottomTabWidget QTabBar::tab:hover:!selected,
QTabWidget#rightTabWidget QTabBar::tab:hover:!selected {
    color: #1e1e1e;
    background: #e8e8e8;
}

/* ---- Bottom/Right Pivot Row (title bar replacement) ---- */
QWidget#bottomPivotRow,
QWidget#rightPivotRow {
    background: #f3f3f3;
    border-bottom: 1px solid #e8e8e8;
}
QWidget#bottomPivotRow QToolButton#panelCloseBtn,
QWidget#rightPivotRow QToolButton#panelCloseBtn {
    background: transparent;
    border: none;
    border-radius: 3px;
    color: #8c8c8c;
    font-size: 14px;
    padding: 0;
    margin: 0;
}
QWidget#bottomPivotRow QToolButton#panelCloseBtn:hover,
QWidget#rightPivotRow QToolButton#panelCloseBtn:hover {
    background: #e0e0e0;
    color: #1e1e1e;
}

/* ---- Bottom Panel ---- */
QWidget#bottomPanel,
QWidget#bottomPanelContainer {
    background: #ffffff;
    border: none;
    border-top: 1px solid #e8e8e8;
}

/* ---- Right Panel ---- */
QWidget#rightPanel,
QWidget#rightPanelContainer {
    background: #ffffff;
    border: none;
    border-left: 1px solid #e8e8e8;
}

/* ---- Text Edits ---- */
QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    border: none;
    selection-background-color: #cde8f8;
    selection-color: #1e1e1e;
}
QTextEdit#outputEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    border: none;
    border-top: 1px solid #e8e8e8;
    padding: 8px 14px;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 13px;
}

/* ---- Error List (clickable) ---- */
QListWidget#errorList {
    background-color: #ffffff;
    color: #d13438;
    border: none;
    border-top: 1px solid #e8e8e8;
    outline: none;
    padding: 4px 8px;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 13px;
}
QListWidget#errorList::item {
    padding: 6px 12px;
    border-bottom: 1px solid #f5f5f5;
    border-radius: 4px;
    margin: 1px 4px;
}
QListWidget#errorList::item:hover {
    background: #fef6f6;
}
QListWidget#errorList::item:selected {
    background: #fce4e6;
    color: #a3210e;
}

/* ---- Tree Widget ---- */
QTreeWidget {
    background: #f3f3f3;
    color: #1e1e1e;
    border: none;
    outline: none;
    alternate-background-color: transparent;
}
QTreeWidget::item {
    padding: 5px 0px;
    border: none;
}
QTreeWidget::item:selected {
    background: #cce4f7;
    color: #005a9e;
}
QTreeWidget::item:hover:!selected {
    background: #e8e8e8;
}
QTreeWidget::branch {
    background: transparent;
}
QTreeWidget::branch:has-siblings:!adjoins-item {
    background: transparent;
}
QTreeWidget::branch:has-siblings:adjoins-item {
    background: transparent;
}
QTreeWidget::branch:!has-children:!has-siblings:adjoins-item {
    background: transparent;
}
QTreeWidget::branch:open {
    background: transparent;
    image: none;
}
QTreeWidget::branch:closed:has-children {
    background: transparent;
    image: none;
}

/* ---- List Widget ---- */
QListWidget {
    background: #ffffff;
    color: #1e1e1e;
    border: none;
    outline: none;
    alternate-background-color: #fafafa;
}
QListWidget::item {
    padding: 4px 8px;
    border: none;
}
QListWidget::item:selected {
    background: #cce4f7;
    color: #005a9e;
}
QListWidget::item:hover:!selected {
    background: #f0f0f0;
}

/* ---- Table Widget — flat header, clean grid ---- */
QTableWidget {
    background: #ffffff;
    color: #1e1e1e;
    gridline-color: #f0f0f0;
    selection-background-color: #cce4f7;
    selection-color: #005a9e;
    border: none;
    outline: none;
}
QTableWidget::item {
    padding: 5px 8px;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
}
QHeaderView::section {
    background: #fafafa;
    color: #5a5a5a;
    padding: 7px 10px;
    border: none;
    border-right: 1px solid #f0f0f0;
    border-bottom: 1px solid #e8e8e8;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.5px;
    min-height: 30px;
}
QHeaderView::section:last {
    border-right: none;
}

/* ---- Bytecode List ---- */
QListWidget#bytecodeList {
    background-color: #fafafa;
    color: #1e1e1e;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
    padding: 6px;
}
QListWidget#bytecodeList::item {
    padding: 3px 8px;
    border-bottom: 1px solid #f0f0f0;
    border-radius: 2px;
}
QListWidget#bytecodeList::item:selected {
    background-color: #cce4f7;
    color: #005a9e;
}
QListWidget#bytecodeList::item:hover:!selected {
    background-color: #f0f0f0;
}

/* ---- VM Stack Panel ---- */
QLabel#vmOpLabel {
    background-color: #f0faf4;
    color: #1a7f37;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
    padding: 8px;
    border-radius: 5px;
    border: 1px solid #d4edda;
}
QLabel#vmStackTitle,
QLabel#vmGlobalsTitle {
    color: #5a5a5a;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    letter-spacing: 0.8px;
}
QListWidget#vmStackList {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #e8e8e8;
    border-radius: 5px;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
}
QListWidget#vmStackList::item {
    padding: 3px 6px;
    border-bottom: 1px solid #f0f0f0;
}
QListWidget#vmStackList::item:selected {
    background-color: #cce4f7;
    color: #005a9e;
}
QTableWidget#vmGlobalsTable {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #e8e8e8;
    border-radius: 5px;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
}
QTableWidget#vmGlobalsTable QHeaderView::section {
    background-color: #f3f3f3;
    color: #5a5a5a;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #f0f0f0;
    border-bottom: 1px solid #e8e8e8;
    font-weight: 500;
    letter-spacing: 0;
}

/* ---- Find/Replace Panel ---- */
QWidget#findReplacePanel {
    background-color: #fafafa;
    border-bottom: 1px solid #e8e8e8;
}

/* ---- Line Edit ---- */
QLineEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d4d4d4;
    border-radius: 5px;
    padding: 6px 10px;
    selection-background-color: #cde8f8;
    selection-color: #1e1e1e;
}
QLineEdit:hover {
    border-color: #b0b0b0;
}
QLineEdit:focus {
    border: 1px solid #0078d4;
}
QLineEdit:disabled {
    color: #b0b0b0;
    background: #f5f5f5;
    border-color: #e0e0e0;
}

/* ---- Push Button (4-state) ---- */
QPushButton {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d4d4d4;
    padding: 6px 16px;
    border-radius: 5px;
    outline: none;
}
QPushButton:hover {
    background-color: #f5f5f5;
    border-color: #b0b0b0;
    color: #1e1e1e;
}
QPushButton:pressed {
    background-color: #e0e0e0;
    border-color: #a0a0a0;
    color: #1e1e1e;
}
QPushButton:disabled {
    color: #b0b0b0;
    background: #f5f5f5;
    border-color: #e0e0e0;
}
QPushButton:focus {
    outline: none;
    border: 1px solid #0078d4;
}

/* ---- Check Box ---- */
QCheckBox {
    color: #1e1e1e;
    spacing: 7px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #b0b0b0;
    border-radius: 4px;
    background: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #0078d4;
}
QCheckBox::indicator:checked {
    background: #0078d4;
    border-color: #0078d4;
}
QCheckBox:disabled {
    color: #b0b0b0;
}

/* ---- Combo Box ---- */
QComboBox {
    background: #ffffff;
    border: 1px solid #d4d4d4;
    border-radius: 5px;
    padding: 6px 10px;
    color: #1e1e1e;
}
QComboBox:hover {
    border-color: #0078d4;
}
QComboBox:disabled {
    color: #b0b0b0;
    background: #f5f5f5;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d4d4d4;
    border-radius: 5px;
    selection-background-color: #cce4f7;
    selection-color: #005a9e;
    outline: none;
}

/* ---- Scroll Bars (thin: 6px default, 10px hover) ---- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
    border: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 0.18);
    min-height: 30px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: rgba(0, 0, 0, 0.18);
    min-width: 30px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar:vertical:hover {
    width: 10px;
}
QScrollBar:horizontal:hover {
    height: 10px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(0, 0, 0, 0.35);
}
QScrollBar::handle:horizontal:hover {
    background: rgba(0, 0, 0, 0.35);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    width: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---- Status Bar ---- */
QStatusBar {
    background: #0078d4;
    color: #ffffff;
    border: none;
    font-size: 12px;
}
QStatusBar QLabel {
    color: rgba(255, 255, 255, 0.9);
    padding: 0px 10px;
}
QStatusBar QPushButton {
    background: transparent;
    color: rgba(255, 255, 255, 0.9);
    border: none;
    padding: 0px 10px;
    border-radius: 3px;
}
QStatusBar QPushButton:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
}

/* ---- Debug Panel ---- */
QWidget#debugVarLabel,
QWidget#debugStackLabel {
    font-weight: 600;
    color: #5a5a5a;
    font-size: 11px;
    letter-spacing: 0.8px;
}
QLabel#errorLabel {
    color: #d13438;
    font-weight: 600;
}
QLabel#outputLabel {
    font-weight: 600;
    color: #1e1e1e;
}

/* ---- REPL Panel ---- */
QWidget#replPanel {
    background: #ffffff;
}

/* ---- Central Widget ---- */
QWidget#centralWidget {
    background: #ffffff;
}

/* ---- Group Box ---- */
QGroupBox {
    border: 1px solid #e8e8e8;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
    color: #1e1e1e;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #5a5a5a;
}

/* ---- Spin Box ---- */
QSpinBox {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d4d4d4;
    border-radius: 5px;
    padding: 5px 10px;
}
QSpinBox:hover {
    border-color: #0078d4;
}
QSpinBox:disabled {
    color: #b0b0b0;
    background: #f5f5f5;
}
QSpinBox::up-button, QSpinBox::down-button {
    background: #f3f3f3;
    border: none;
    width: 16px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: #e0e0e0;
}

/* ---- Text Browser ---- */
QTextBrowser {
    background-color: #ffffff;
    color: #1e1e1e;
    border: none;
}

/* ---- Generic Label / Frame ---- */
QLabel {
    color: #1e1e1e;
    background: transparent;
}
QFrame {
    color: #1e1e1e;
    background: transparent;
}

/* ---- Scroll Area ---- */
QScrollArea {
    background: #ffffff;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: #ffffff;
}

/* ---- Pivot (QFluentKit tabs) ---- */
Pivot {
    background: transparent;
    border: none;
}
