/* ============================================================
   MiniLang IDE - Dark Theme Stylesheet (styles_dark.qss)
   ============================================================ */

/* ---- Global: Main Window ---- */
QMainWindow {
    background-color: #1e1e1e;
}

/* ---- Global: Tab Widget ---- */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    background: #252526;
}
QTabBar::tab {
    padding: 6px 14px;
    border: 1px solid #3c3c3c;
    border-bottom: none;
    background: #2d2d2d;
    color: #cccccc;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #1e1e1e;
    border-bottom: 2px solid #0e639c;
    color: #ffffff;
}
QTabBar::tab:hover {
    background: #3c3c3c;
}

/* ---- Global: Toolbar ---- */
QToolBar {
    background: #2d2d2d;
    border-bottom: 1px solid #3c3c3c;
    spacing: 4px;
    padding: 2px;
}
QToolBar QToolButton {
    padding: 4px 10px;
    border: 1px solid transparent;
    border-radius: 3px;
    background: transparent;
    color: #cccccc;
    font-size: 13px;
}
QToolBar QToolButton:hover {
    background: #3c3c3c;
    border: 1px solid #505050;
}
QToolBar QToolButton:pressed {
    background: #0e639c;
}
QToolBar QToolButton:disabled {
    color: #5a5a5a;
}

/* ---- Global: Menu Bar ---- */
QMenuBar {
    background: #2d2d2d;
    color: #cccccc;
    border-bottom: 1px solid #3c3c3c;
}
QMenuBar::item:selected {
    background: #3c3c3c;
}
QMenu {
    background: #2d2d2d;
    color: #cccccc;
    border: 1px solid #3c3c3c;
}
QMenu::item:selected {
    background: #0e639c;
    color: white;
}

/* ---- Global: Splitter ---- */
QSplitter::handle {
    background: #3c3c3c;
}
QSplitter::handle:horizontal {
    width: 3px;
}
QSplitter::handle:vertical {
    height: 3px;
}

/* ---- Global: Table Widget ---- */
QTableWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
    gridline-color: #3c3c3c;
    selection-background-color: #264f78;
    selection-color: white;
    border: 1px solid #3c3c3c;
}
QTableWidget::item {
    padding: 2px 6px;
}

/* ---- Global: Header View ---- */
QHeaderView::section {
    background: #2d2d2d;
    color: #cccccc;
    padding: 4px 8px;
    border: 1px solid #3c3c3c;
    font-weight: bold;
}

/* ---- Global: Tree Widget ---- */
QTreeWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    alternate-background-color: #252526;
}

/* ---- Global: List Widget ---- */
QListWidget {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    alternate-background-color: #252526;
}

/* ---- Global: Text Edit / Plain Text Edit ---- */
QPlainTextEdit, QTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    selection-background-color: #264f78;
    selection-color: white;
}

/* ---- Global: Line Edit ---- */
QLineEdit {
    background-color: #2d2d2d;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    padding: 3px 6px;
    selection-background-color: #264f78;
    selection-color: white;
}
QLineEdit:focus {
    border: 1px solid #0e639c;
}

/* ---- Global: Push Button ---- */
QPushButton {
    background-color: #0e639c;
    color: white;
    border: none;
    padding: 5px 14px;
    border-radius: 3px;
}
QPushButton:hover {
    background-color: #1177bb;
}
QPushButton:pressed {
    background-color: #094771;
}
QPushButton:disabled {
    background-color: #3c3c3c;
    color: #5a5a5a;
}

/* ---- Global: Check Box ---- */
QCheckBox {
    color: #cccccc;
    spacing: 6px;
}

/* ---- Global: Status Bar ---- */
QStatusBar {
    background: #007acc;
    color: white;
    border-top: 1px solid #3c3c3c;
}
QStatusBar QLabel {
    color: white;
}

/* ============================================================
   Panel section title labels
   ============================================================ */
QLabel#outputLabel,
QLabel#errorLabel,
QLabel#debugVarLabel,
QLabel#debugStackLabel {
    font-weight: bold;
    color: #cccccc;
}

/* Error label uses red color */
QLabel#errorLabel {
    color: #f48771;
}

/* ============================================================
   Panel clear buttons
   ============================================================ */
QPushButton#clearOutputBtn,
QPushButton#clearErrorBtn {
    padding: 2px 8px;
}

/* ============================================================
   Output panel text edits
   ============================================================ */
QTextEdit#outputEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
}

QTextEdit#errorEdit {
    background-color: #2d1e1e;
    color: #f48771;
    border: 1px solid #5c3a3a;
}

/* ============================================================
   VM Stack Panel - Dark theme widgets
   ============================================================ */

/* Current operation label */
QLabel#vmOpLabel {
    background-color: #2d2d2d;
    color: #00ff88;
    font-family: Consolas, monospace;
    font-size: 12px;
    padding: 6px;
    border-radius: 4px;
    border: 1px solid #444;
}

/* Section titles inside VM panel (stack title, globals title) */
QLabel#vmStackTitle,
QLabel#vmGlobalsTitle {
    color: #aaa;
    font-size: 11px;
    font-weight: bold;
    padding: 2px;
}

/* Operand stack list */
QListWidget#vmStackList {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #444;
    border-radius: 4px;
}
QListWidget#vmStackList::item {
    padding: 3px 6px;
    border-bottom: 1px solid #333;
}
QListWidget#vmStackList::item:selected {
    background-color: #264f78;
}

/* Globals table */
QTableWidget#vmGlobalsTable {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: 1px solid #444;
    border-radius: 4px;
}
QTableWidget#vmGlobalsTable QHeaderView::section {
    background-color: #2d2d2d;
    color: #ccc;
    padding: 4px;
    border: 1px solid #444;
    font-weight: bold;
}

/* ============================================================
   Bytecode list (dark theme)
   ============================================================ */
QListWidget#bytecodeList {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
}
QListWidget#bytecodeList::item {
    padding: 2px 6px;
    border-bottom: 1px solid #333;
}
QListWidget#bytecodeList::item:selected {
    background-color: #264f78;
}

/* ============================================================
   Find/Replace Panel
   ============================================================ */
QWidget#findReplacePanel {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3c3c3c;
}

/* ============================================================
   Scroll bars
   ============================================================ */
QScrollBar:vertical {
    background: #1e1e1e;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #424242;
    min-height: 30px;
    border-radius: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #4f4f4f;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0;
}
QScrollBar:horizontal {
    background: #1e1e1e;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #424242;
    min-width: 30px;
    border-radius: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #4f4f4f;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    width: 0;
}
